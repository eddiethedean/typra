class AsyncDatabase:
    """Asyncio database handle: thread-pool engine work; concurrent reads, exclusive writes."""

    @staticmethod
    def open(
        path: str, *, read_only: bool = ..., recovery: str | None = ...
    ) -> Awaitable[AsyncDatabase]: ...
    @staticmethod
    def open_in_memory() -> Awaitable[AsyncDatabase]: ...
    @staticmethod
    def open_snapshot_bytes(data: bytes) -> Awaitable[AsyncDatabase]: ...
    @staticmethod
    def open_snapshot(path: str) -> Awaitable[AsyncDatabase]: ...
    @staticmethod
    def restore_snapshot(snapshot_path: str, dest_path: str) -> Awaitable[None]: ...
    def path(self) -> Awaitable[str]: ...
    def register_collection(
        self,
        name: str,
        fields_json: str,
        primary_field: str,
        indexes_json: str | None = ...,
    ) -> Awaitable[tuple[int, int]]: ...
    def collection_names(self) -> Awaitable[list[str]]: ...
    def collection(self, name: str) -> AsyncCollection: ...
    def insert(self, collection_name: str, row: dict[str, Any]) -> Awaitable[None]: ...
    def delete(self, collection_name: str, pk: Any) -> Awaitable[None]: ...
    def get(
        self, collection_name: str, pk: Any
    ) -> Awaitable[dict[str, Any] | None]: ...
    def register_schema_version(
        self,
        collection_name: str,
        fields_json: str,
        indexes_json: str | None = ...,
        *,
        force: bool = ...,
    ) -> Awaitable[int]: ...
    def plan_schema_version(
        self,
        collection_name: str,
        fields_json: str,
        indexes_json: str | None = ...,
    ) -> Awaitable[dict[str, Any]]: ...
    def backfill_top_level_field(
        self,
        collection_name: str,
        field: str,
        value: Any,
    ) -> Awaitable[None]: ...
    def backfill_field_at_path(
        self,
        collection_name: str,
        path: list[str],
        value: Any,
    ) -> Awaitable[None]: ...
    def rebuild_indexes(self, collection_name: str) -> Awaitable[None]: ...
    def compact_to(self, dest_path: str) -> Awaitable[None]: ...
    def compact(self) -> Awaitable[None]: ...
    def snapshot_bytes(self) -> Awaitable[bytes]: ...
    def export_snapshot(self, dest_path: str) -> Awaitable[None]: ...
    def transaction(self) -> AsyncTransaction: ...

