class Database:
    """Sync database handle: concurrent reads (shared lock), exclusive writes."""

    @staticmethod
    def open(
        path: str, *, read_only: bool = ..., recovery: str | None = ...
    ) -> Database: ...
    @staticmethod
    def open_in_memory() -> Database: ...
    @staticmethod
    def open_snapshot_bytes(data: bytes) -> Database: ...
    @staticmethod
    def open_snapshot(path: str) -> Database: ...
    @staticmethod
    def restore_snapshot(snapshot_path: str, dest_path: str) -> None: ...
    def path(self) -> str: ...
    @overload
    def register_collection(
        self,
        name: str,
        fields_json: str,
        primary_field: str,
        indexes_json: None = ...,
    ) -> tuple[int, int]: ...
    @overload
    def register_collection(
        self,
        name: str,
        fields_json: str,
        primary_field: str,
        indexes_json: str,
    ) -> tuple[int, int]: ...
    def collection_names(self) -> list[str]: ...
    def collection(self, name: str) -> Collection: ...
    def insert(self, collection_name: str, row: dict[str, Any]) -> None: ...
    def delete(self, collection_name: str, pk: Any) -> None: ...
    def get(self, collection_name: str, pk: Any) -> dict[str, Any] | None: ...
    def register_schema_version(
        self,
        collection_name: str,
        fields_json: str,
        indexes_json: str | None = ...,
        *,
        force: bool = ...,
    ) -> int: ...
    def plan_schema_version(
        self,
        collection_name: str,
        fields_json: str,
        indexes_json: str | None = ...,
    ) -> dict[str, Any]: ...
    def backfill_top_level_field(
        self,
        collection_name: str,
        field: str,
        value: Any,
    ) -> None: ...
    def backfill_field_at_path(
        self,
        collection_name: str,
        path: list[str],
        value: Any,
    ) -> None: ...
    def rebuild_indexes(self, collection_name: str) -> None: ...
    def compact_to(self, dest_path: str) -> None: ...
    def compact(self) -> None: ...
    def snapshot_bytes(self) -> bytes: ...
    def export_snapshot(self, dest_path: str) -> None: ...
    def transaction(self) -> Transaction: ...

